<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degradado"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <ImageView
            android:layout_width="@dimen/tam_logo"
            android:layout_height="@dimen/tam_logo"
            android:layout_marginTop="@dimen/espacio_grande"
            android:contentDescription="@string/descripcion_logo"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio"
            android:fontFamily="sans-serif-medium"
            android:text="@string/marca"
            android:textColor="@color/texto"
            android:textSize="@dimen/texto_marca"
            android:textStyle="bold" />

        <TextView
            style="@style/TextoSeccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_grande"
            android:text="@string/subtitulo_ingreso" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margen_pantalla">

                <TextView
                    style="@style/TextoTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo_ingreso" />

                <TextView
                    style="@style/TextoSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/espacio_grande"
                    android:text="@string/detalle_ingreso" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_correo"
                    app:startIconDrawable="@drawable/ic_correo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress"
                        android:minHeight="@dimen/alto_minimo_toque" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilClave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio"
                    android:hint="@string/hint_clave"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_candado">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etClave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:inputType="textPassword"
                        android:minHeight="@dimen/alto_minimo_toque" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio"
                    android:indeterminate="true"
                    android:visibility="invisible"
                    app:indicatorColor="@color/dorado"
                    app:trackCornerRadius="4dp" />

                <Button
                    android:id="@+id/btnIngresar"
                    style="@style/BotonPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio"
                    android:text="@string/boton_ingresar" />

                <Button
                    android:id="@+id/btnIrRegistro"
                    style="@style/BotonTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boton_ir_registro" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_grande"
            android:drawablePadding="@dimen/espacio_chico"
            android:gravity="center_vertical"
            android:text="@string/pie_seguridad"
            app:drawableStartCompat="@drawable/ic_escudo"
            app:drawableTint="@color/texto_tenue" />
    </LinearLayout>
</ScrollView>
