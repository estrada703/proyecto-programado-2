<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <TextView
                android:id="@+id/tvSaludo"
                style="@style/TextoTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/TextoSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio"
                android:text="@string/subtitulo_resumen" />

            <TextView
            android:id="@+id/tvBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio"
            android:background="@drawable/bg_banner"
            android:drawablePadding="@dimen/espacio_chico"
            android:gravity="center_vertical"
            android:padding="@dimen/espacio"
            android:textColor="@color/texto_banner"
            android:textSize="@dimen/texto_pequeno"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_sin_conexion"
            app:drawableTint="@color/texto_banner" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/dorado"
                app:trackColor="@color/fondo" />

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/kpiIngresos"
                layout="@layout/item_kpi" />

            <include
                android:id="@+id/kpiPedidos"
                layout="@layout/item_kpi" />
        </LinearLayout>
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/kpiTicket"
                layout="@layout/item_kpi" />

            <include
                android:id="@+id/kpiArticulos"
                layout="@layout/item_kpi" />
        </LinearLayout>

            <TextView
                style="@style/TextoSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_grande"
                android:layout_marginBottom="@dimen/espacio_chico"
                android:text="@string/seccion_franquicias" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <cr.ac.monkeystore.movil.ui.BarrasView
                    android:id="@+id/barras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/descripcion_grafico"
                    android:padding="@dimen/margen_pantalla" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextoSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_grande"
                android:layout_marginBottom="@dimen/espacio_chico"
                android:text="@string/seccion_mas_vendidos" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/contMasVendidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/margen_pantalla"
                    android:paddingTop="@dimen/espacio_chico"
                    android:paddingEnd="@dimen/margen_pantalla"
                    android:paddingBottom="@dimen/espacio_chico" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextoSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_grande"
                android:layout_marginBottom="@dimen/espacio_chico"
                android:text="@string/seccion_estados" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/contEstados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/margen_pantalla"
                    android:paddingTop="@dimen/espacio_chico"
                    android:paddingEnd="@dimen/margen_pantalla"
                    android:paddingBottom="@dimen/espacio_chico" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
