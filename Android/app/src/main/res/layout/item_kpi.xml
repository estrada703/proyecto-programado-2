<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_chico"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <TextView
            android:id="@+id/tvKpiEtiqueta"
            style="@style/TextoEtiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvKpiValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_chico"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/texto"
            android:textSize="@dimen/texto_kpi"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKpiNota"
            style="@style/TextoEtiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dorado"
            android:textSize="@dimen/texto_mini"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
