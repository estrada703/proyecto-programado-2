@model LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
}
<h1>Ingresar</h1>
<form asp-action="Login" method="post" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Correo" class="form-label">Correo</label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Clave" class="form-label">Contraseña</label>
        <input asp-for="Clave" class="form-control" />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>
    <button class="btn btn-danger">Ingresar</button>
</form>
