@model List<Pedido>
@{
    ViewData["Title"] = "Pedidos";
}
<h1>Compras y reservas</h1>
<table class="table table-striped">
    <thead><tr><th>Fecha</th><th>Producto</th><th>Sede</th><th>Tipo</th><th>Cantidad</th><th>Monto</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@p.Platillo?.Nombre</td>
            <td>@p.Sede?.Nombre</td>
            <td>@p.Tipo</td>
            <td>@p.Cantidad</td>
            <td>₡@p.Monto.ToString("N2")</td>
        </tr>
    }
    </tbody>
</table>
