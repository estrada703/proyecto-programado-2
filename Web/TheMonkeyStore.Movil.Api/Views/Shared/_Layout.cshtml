<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · The Monkey Store</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-dark text-light" style="background:#0E1714!important">
<nav class="navbar navbar-expand navbar-dark" style="background:#15221D;border-bottom:1px solid #D9B465">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">The Monkey Store <small class="text-warning">· Admin</small></a>
        <ul class="navbar-nav me-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item"><a class="nav-link" asp-controller="Pedidos" asp-action="Index">Pedidos</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
            }
        </ul>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">
                <button class="btn btn-outline-warning btn-sm">Cerrar sesión</button>
            </form>
        }
        else
        {
            <a class="btn btn-outline-warning btn-sm" asp-controller="Account" asp-action="Login">Ingresar</a>
        }
    </div>
</nav>
<main class="container py-4">
    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-info">@mensaje</div>
    }
    @RenderBody()
</main>
</body>
</html>
