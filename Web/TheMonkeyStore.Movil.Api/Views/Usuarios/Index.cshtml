@model List<ApplicationUser>
@{
    ViewData["Title"] = "Administradores";
}
<h1>Administradores</h1>
<table class="table table-dark align-middle">
    <thead><tr><th>Nombre</th><th>Correo</th><th>Acceso móvil</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.NombreCompleto</td>
            <td>@u.Email</td>
            <td>@(u.AccesoMovilHabilitado ? "Habilitado" : "Deshabilitado")</td>
            <td>
                <form asp-action="CambiarAccesoMovil" method="post">
                    <input type="hidden" name="id" value="@u.Id" />
                    <button class="btn btn-sm btn-outline-warning">
                        @(u.AccesoMovilHabilitado ? "Deshabilitar" : "Habilitar")
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
